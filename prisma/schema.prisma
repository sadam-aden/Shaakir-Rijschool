// RijSchool Planner — database schema.
// Conventions: money = integer cents, durations = integer minutes, timestamps = timestamptz (UTC).
// Every table carries schoolId (single school now, multi-tenant-ready).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  INSTRUCTOR
}

enum Locale {
  nl
  en
}

enum Gearbox {
  MANUAL
  AUTOMATIC
}

enum StudentTrack {
  PRACTICAL
  THEORY_ONLY
  BOTH
}

enum StudentStatus {
  WAITING_LIST
  ACTIVE
  PAUSED
  PASSED
  ARCHIVED
}

enum DayPart {
  MORNING
  AFTERNOON
  EVENING
}

enum PackageType {
  PRACTICAL
  THEORY
  EXAM_BUNDLE
}

enum StudentPackageStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LedgerType {
  PURCHASE
  RESERVE
  RELEASE
  CONSUME
  ADJUST
  REFUND
}

enum LessonType {
  PRACTICAL
  THEORY
  EXAM
}

enum LessonStatus {
  DRAFT
  PLANNED
  COMPLETED
  NO_SHOW
  CANCELLED_STUDENT
  CANCELLED_SCHOOL
}

enum LessonSource {
  MANUAL
  AI
  RECURRING
}

enum Attendance {
  ENROLLED
  ATTENDED
  NO_SHOW
}

enum ExamKind {
  THEORY
  PRACTICAL
  TUSSENTIJDSE_TOETS
}

enum ExamStatus {
  REQUESTED
  SCHEDULED
  PASSED
  FAILED
  CANCELLED
}

enum Readiness {
  READY
  NEEDS_LESSONS
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  IDEAL
  BANK_TRANSFER
  CASH
  PIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED
  DISCARDED
  PARTIALLY_APPROVED
}

enum DraftItemOutcome {
  KEPT
  MOVED
  REMOVED
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// ───────────── School & users ─────────────

model School {
  id            String   @id @default(cuid())
  name          String
  address       String?
  postcode      String?
  city          String?
  kvk           String?
  btw           String?
  iban          String?
  timezone      String   @default("Europe/Amsterdam")
  logoUrl       String?
  defaultLocale Locale   @default(nl)
  /// maxTeachingMinutesPerDay, travelBufferMin, cancellationWindowHours, reminder toggles,
  /// allowBookingOnUnpaid, vatRate, paymentTermDays, reminderDays, smsSender, scheduling rules
  settings      Json     @default("{}")
  createdAt     DateTime @default(now()) @db.Timestamptz()

  users           User[]
  instructors     Instructor[]
  students        Student[]
  packages        Package[]
  studentPackages StudentPackage[]
  ledger          HoursLedgerEntry[]
  lessons         Lesson[]
  recurrenceRules RecurrenceRule[]
  theoryGroups    TheoryGroup[]
  exams           Exam[]
  skills          Skill[]
  vehicles        Vehicle[]
  invoices        Invoice[]
  payments        Payment[]
  scheduleDrafts  ScheduleDraft[]
  notifications   Notification[]
  inAppNotifs     InAppNotification[]
  auditLogs       AuditLog[]
  invoiceCounters InvoiceCounter[]
}

model User {
  id            String    @id @default(cuid())
  schoolId      String
  email         String    @unique
  name          String
  phone         String?
  passwordHash  String?
  role          Role      @default(INSTRUCTOR)
  locale        Locale    @default(nl)
  isActive      Boolean   @default(true)
  emailVerified DateTime? @db.Timestamptz()
  createdAt     DateTime  @default(now()) @db.Timestamptz()

  school      School              @relation(fields: [schoolId], references: [id])
  instructor  Instructor?
  invites     Invite[]
  auditLogs   AuditLog[]
  inAppNotifs InAppNotification[]

  @@index([schoolId])
}

/// Invitation (admin invites instructors by e-mail) and magic-link tokens.
model Invite {
  id          String    @id @default(cuid())
  schoolId    String
  email       String
  role        Role      @default(INSTRUCTOR)
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz()
  acceptedAt  DateTime? @db.Timestamptz()
  invitedById String?
  createdAt   DateTime  @default(now()) @db.Timestamptz()

  invitedBy User? @relation(fields: [invitedById], references: [id])

  @@index([schoolId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz()

  @@id([identifier, token])
}

model Instructor {
  id               String  @id @default(cuid())
  schoolId         String
  userId           String  @unique
  displayName      String
  color            String  @default("#1D4ED8")
  licenceNumber    String?
  maxMinutesPerDay Int     @default(480)
  homeAddress      String?
  homeLat          Float?
  homeLng          Float?
  defaultVehicleId String?
  active           Boolean @default(true)

  school         School                   @relation(fields: [schoolId], references: [id])
  user           User                     @relation(fields: [userId], references: [id])
  defaultVehicle Vehicle?                 @relation("InstructorDefaultVehicle", fields: [defaultVehicleId], references: [id])
  workingHours   InstructorWorkingHours[]
  timeOff        InstructorTimeOff[]
  students       Student[]
  lessons        Lesson[]
  theoryGroups   TheoryGroup[]
  drafts         ScheduleDraft[]
  vehicles       Vehicle[]                @relation("VehicleAssignedInstructor")

  @@index([schoolId])
}

model InstructorWorkingHours {
  id           String @id @default(cuid())
  schoolId     String
  instructorId String
  /// 1 = Monday … 7 = Sunday (ISO)
  weekday      Int
  /// minutes since local midnight
  startMin     Int
  endMin       Int

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([instructorId, weekday])
}

model InstructorTimeOff {
  id           String   @id @default(cuid())
  schoolId     String
  instructorId String
  startsAt     DateTime @db.Timestamptz()
  endsAt       DateTime @db.Timestamptz()
  reason       String?

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([instructorId, startsAt])
}

// ───────────── Students ─────────────

model Student {
  id                  String        @id @default(cuid())
  schoolId            String
  firstName           String
  lastName            String
  phone               String?
  email               String?
  birthDate           DateTime?     @db.Date
  address             String?
  postcode            String?
  /// province (e.g. Zuid-Holland) and city/village (e.g. Rotterdam) chosen from the Dutch places list
  province            String?
  city                String?
  /// neighbourhood (wijk), e.g. Delfshaven
  area                String?
  lat                 Float?
  lng                 Float?
  gearbox             Gearbox       @default(MANUAL)
  track               StudentTrack  @default(PRACTICAL)
  status              StudentStatus @default(ACTIVE)
  primaryInstructorId String?
  since               DateTime      @default(now()) @db.Date
  notes               String?
  smsConsent          Boolean       @default(false)
  emailConsent        Boolean       @default(false)
  locale              Locale        @default(nl)
  cbrCandidateNumber  String?
  avatarColor         String        @default("#DBEAFE")
  guardianName        String?
  guardianPhone       String?
  guardianEmail       String?
  /// cached from the ledger, updated in the same transaction
  minutesRemaining    Int           @default(0)
  minutesReserved     Int           @default(0)
  createdAt           DateTime      @default(now()) @db.Timestamptz()

  school            School                  @relation(fields: [schoolId], references: [id])
  primaryInstructor Instructor?             @relation(fields: [primaryInstructorId], references: [id])
  availability      StudentAvailability[]
  unavailability    StudentUnavailability[]
  packages          StudentPackage[]
  ledger            HoursLedgerEntry[]
  lessons           Lesson[]
  enrollments       TheoryEnrollment[]
  exams             Exam[]
  skillProgress     SkillProgress[]
  assessments       SkillAssessment[]
  invoices          Invoice[]
  notifications     Notification[]

  @@index([schoolId, status])
  @@index([schoolId, lastName])
}

model StudentAvailability {
  id        String  @id @default(cuid())
  schoolId  String
  studentId String
  weekday   Int
  part      DayPart
  /// optional exact window in minutes since midnight
  startMin  Int?
  endMin    Int?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, weekday, part])
  @@index([schoolId])
}

model StudentUnavailability {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  startsAt  DateTime @db.Timestamptz()
  endsAt    DateTime @db.Timestamptz()
  reason    String?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId, startsAt])
}

// ───────────── Packages, ledger ─────────────

model Package {
  id              String      @id @default(cuid())
  schoolId        String
  nameNl          String
  nameEn          String
  descriptionNl   String?
  descriptionEn   String?
  type            PackageType
  lessonCount     Int
  minutesIncluded Int
  includesExam    Boolean     @default(false)
  priceCents      Int
  vatRate         Int         @default(21)
  isPopular       Boolean     @default(false)
  active          Boolean     @default(true)
  sortOrder       Int         @default(0)

  school    School           @relation(fields: [schoolId], references: [id])
  purchases StudentPackage[]

  @@index([schoolId])
}

model StudentPackage {
  id               String               @id @default(cuid())
  schoolId         String
  studentId        String
  packageId        String
  purchasedAt      DateTime             @default(now()) @db.Timestamptz()
  priceCents       Int
  minutesPurchased Int
  examCredits      Int                  @default(0)
  status           StudentPackageStatus @default(ACTIVE)
  invoiceId        String?

  school  School             @relation(fields: [schoolId], references: [id])
  student Student            @relation(fields: [studentId], references: [id])
  package Package            @relation(fields: [packageId], references: [id])
  invoice Invoice?           @relation(fields: [invoiceId], references: [id])
  ledger  HoursLedgerEntry[]

  @@index([schoolId])
  @@index([studentId])
}

/// Append-only source of truth for hours. Never update or delete rows.
model HoursLedgerEntry {
  id               String     @id @default(cuid())
  schoolId         String
  studentId        String
  studentPackageId String?
  lessonId         String?
  type             LedgerType
  /// signed minutes
  minutes          Int
  note             String?
  createdById      String?
  createdAt        DateTime   @default(now()) @db.Timestamptz()

  school         School          @relation(fields: [schoolId], references: [id])
  student        Student         @relation(fields: [studentId], references: [id])
  studentPackage StudentPackage? @relation(fields: [studentPackageId], references: [id])
  lesson         Lesson?         @relation(fields: [lessonId], references: [id])

  @@index([schoolId])
  @@index([studentId, createdAt])
  @@index([lessonId])
}

// ───────────── Lessons ─────────────

model RecurrenceRule {
  id        String    @id @default(cuid())
  schoolId  String
  frequency String    @default("WEEKLY")
  count     Int?
  until     DateTime? @db.Timestamptz()

  school  School   @relation(fields: [schoolId], references: [id])
  lessons Lesson[]

  @@index([schoolId])
}

model Lesson {
  id                 String       @id @default(cuid())
  schoolId           String
  type               LessonType
  instructorId       String
  studentId          String?
  theoryGroupId      String?
  vehicleId          String?
  startsAt           DateTime     @db.Timestamptz()
  endsAt             DateTime     @db.Timestamptz()
  durationMin        Int
  gearbox            Gearbox?
  pickupAddress      String?
  pickupLat          Float?
  pickupLng          Float?
  status             LessonStatus @default(PLANNED)
  cancellationReason String?
  chargeable         Boolean      @default(true)
  source             LessonSource @default(MANUAL)
  scheduleDraftId    String?
  recurrenceRuleId   String?
  instructorNotes    String?
  studentNotes       String?
  completedAt        DateTime?    @db.Timestamptz()
  createdAt          DateTime     @default(now()) @db.Timestamptz()

  school         School              @relation(fields: [schoolId], references: [id])
  instructor     Instructor          @relation(fields: [instructorId], references: [id])
  student        Student?            @relation(fields: [studentId], references: [id])
  theoryGroup    TheoryGroup?        @relation(fields: [theoryGroupId], references: [id])
  vehicle        Vehicle?            @relation(fields: [vehicleId], references: [id])
  scheduleDraft  ScheduleDraft?      @relation(fields: [scheduleDraftId], references: [id])
  recurrenceRule RecurrenceRule?     @relation(fields: [recurrenceRuleId], references: [id])
  ledger         HoursLedgerEntry[]
  assessments    SkillAssessment[]
  exam           Exam[]
  draftItems     ScheduleDraftItem[]

  @@index([schoolId, startsAt])
  @@index([instructorId, startsAt])
  @@index([studentId, startsAt])
  @@index([vehicleId, startsAt])
}

model TheoryGroup {
  id           String   @id @default(cuid())
  schoolId     String
  titleNl      String
  titleEn      String
  topic        String?
  startsAt     DateTime @db.Timestamptz()
  endsAt       DateTime @db.Timestamptz()
  location     String?
  capacity     Int      @default(10)
  instructorId String

  school      School             @relation(fields: [schoolId], references: [id])
  instructor  Instructor         @relation(fields: [instructorId], references: [id])
  enrollments TheoryEnrollment[]
  lessons     Lesson[]

  @@index([schoolId, startsAt])
}

model TheoryEnrollment {
  id            String     @id @default(cuid())
  schoolId      String
  theoryGroupId String
  studentId     String
  attendance    Attendance @default(ENROLLED)

  theoryGroup TheoryGroup @relation(fields: [theoryGroupId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id])

  @@unique([theoryGroupId, studentId])
  @@index([schoolId])
}

model Exam {
  id                  String     @id @default(cuid())
  schoolId            String
  studentId           String
  kind                ExamKind
  scheduledAt         DateTime?  @db.Timestamptz()
  cbrLocation         String?
  lessonId            String?
  status              ExamStatus @default(REQUESTED)
  attemptNumber       Int        @default(1)
  readiness           Readiness  @default(NEEDS_LESSONS)
  lessonsLeftEstimate Int?
  notes               String?

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])

  @@index([schoolId, scheduledAt])
  @@index([studentId])
}

// ───────────── Skills ─────────────

model Skill {
  id        String  @id @default(cuid())
  schoolId  String
  key       String
  nameNl    String
  nameEn    String
  isCore    Boolean @default(true)
  sortOrder Int     @default(0)

  school      School            @relation(fields: [schoolId], references: [id])
  progress    SkillProgress[]
  assessments SkillAssessment[]

  @@unique([schoolId, key])
}

model SkillProgress {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  skillId   String
  /// 0–100
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([studentId, skillId])
  @@index([schoolId])
}

model SkillAssessment {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  skillId   String
  lessonId  String?
  value     Int
  createdAt DateTime @default(now()) @db.Timestamptz()

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])

  @@index([schoolId])
  @@index([studentId, createdAt])
}

// ───────────── Vehicles ─────────────

model Vehicle {
  id                   String        @id @default(cuid())
  schoolId             String
  name                 String
  licensePlate         String
  gearbox              Gearbox
  color                String?
  dualControl          Boolean       @default(true)
  status               VehicleStatus @default(ACTIVE)
  apkDueDate           DateTime?     @db.Date
  nextServiceDate      DateTime?     @db.Date
  insuranceDueDate     DateTime?     @db.Date
  odometerKm           Int?
  assignedInstructorId String?

  school             School                  @relation(fields: [schoolId], references: [id])
  assignedInstructor Instructor?             @relation("VehicleAssignedInstructor", fields: [assignedInstructorId], references: [id])
  defaultFor         Instructor[]            @relation("InstructorDefaultVehicle")
  unavailability     VehicleUnavailability[]
  lessons            Lesson[]

  @@index([schoolId])
}

model VehicleUnavailability {
  id        String   @id @default(cuid())
  schoolId  String
  vehicleId String
  startsAt  DateTime @db.Timestamptz()
  endsAt    DateTime @db.Timestamptz()
  reason    String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([vehicleId, startsAt])
}

// ───────────── Money ─────────────

model InvoiceCounter {
  schoolId String
  year     Int
  last     Int    @default(0)

  school School @relation(fields: [schoolId], references: [id])

  @@id([schoolId, year])
}

model Invoice {
  id            String        @id @default(cuid())
  schoolId      String
  studentId     String
  /// e.g. 2026-0142
  number        String
  status        InvoiceStatus @default(OPEN)
  /// [{ description, quantity, unitPriceCents, vatRate }]
  lines         Json
  subtotalCents Int
  vatCents      Int
  totalCents    Int
  issuedAt      DateTime      @default(now()) @db.Timestamptz()
  dueDate       DateTime      @db.Date
  pdfUrl        String?
  locale        Locale        @default(nl)

  school    School            @relation(fields: [schoolId], references: [id])
  student   Student           @relation(fields: [studentId], references: [id])
  payments  Payment[]
  reminders PaymentReminder[]
  packages  StudentPackage[]

  @@unique([schoolId, number])
  @@index([schoolId, status])
  @@index([studentId])
}

model Payment {
  id              String        @id @default(cuid())
  schoolId        String
  invoiceId       String
  method          PaymentMethod
  amountCents     Int
  status          PaymentStatus @default(PENDING)
  molliePaymentId String?       @unique
  checkoutUrl     String?
  paidAt          DateTime?     @db.Timestamptz()
  createdAt       DateTime      @default(now()) @db.Timestamptz()

  school  School  @relation(fields: [schoolId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([schoolId, paidAt])
  @@index([invoiceId])
}

model PaymentReminder {
  id        String              @id @default(cuid())
  schoolId  String
  invoiceId String
  sentAt    DateTime            @default(now()) @db.Timestamptz()
  channel   NotificationChannel
  level     Int                 @default(1)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([schoolId])
  @@index([invoiceId])
}

// ───────────── AI scheduling ─────────────

model ScheduleDraft {
  id           String      @id @default(cuid())
  schoolId     String
  date         DateTime    @db.Date
  instructorId String
  status       DraftStatus @default(PENDING_REVIEW)
  stats        Json        @default("{}")
  explanation  String?
  generatedAt  DateTime    @default(now()) @db.Timestamptz()
  reviewedAt   DateTime?   @db.Timestamptz()

  school     School              @relation(fields: [schoolId], references: [id])
  instructor Instructor          @relation(fields: [instructorId], references: [id])
  items      ScheduleDraftItem[]
  lessons    Lesson[]

  @@index([schoolId, date])
  @@index([instructorId, date])
}

model ScheduleDraftItem {
  id               String           @id @default(cuid())
  schoolId         String
  scheduleDraftId  String
  lessonId         String?
  originalStartsAt DateTime         @db.Timestamptz()
  originalEndsAt   DateTime         @db.Timestamptz()
  outcome          DraftItemOutcome @default(KEPT)

  scheduleDraft ScheduleDraft @relation(fields: [scheduleDraftId], references: [id], onDelete: Cascade)
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([scheduleDraftId])
}

// ───────────── Notifications & audit ─────────────

model Notification {
  id           String              @id @default(cuid())
  schoolId     String
  studentId    String?
  channel      NotificationChannel
  template     String
  locale       Locale              @default(nl)
  status       NotificationStatus  @default(QUEUED)
  providerId   String?
  scheduledFor DateTime            @default(now()) @db.Timestamptz()
  sentAt       DateTime?           @db.Timestamptz()
  error        String?
  payload      Json                @default("{}")

  school  School   @relation(fields: [schoolId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@index([schoolId, status, scheduledFor])
}

model InAppNotification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  kind      String
  params    Json      @default("{}")
  href      String?
  readAt    DateTime? @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([schoolId, createdAt])
  @@index([entity, entityId])
}
