# PostgreSQL connection string (local docker-compose default shown)
DATABASE_URL="postgresql://rijschool:rijschool@localhost:5432/rijschool?schema=public"
# Secret used by Auth.js to sign sessions (generate with: npx auth secret)
AUTH_SECRET="change-me"
# Public base URL of the app (used in magic links, payment links and e-mails)
APP_URL="http://localhost:3000"
# Resend API key for e-mail; leave empty to log e-mails to the console instead
RESEND_API_KEY=""
# Sender address for e-mails (display name comes from the school settings)
EMAIL_FROM="noreply@example.com"
# Mollie API key (test_... in development); leave empty to use the local mock iDEAL checkout page. In production set APP_URL to the public https address so Mollie can call the webhook.
MOLLIE_API_KEY=""
# SMS provider: twilio | bird | (empty = console mock)
SMS_PROVIDER=""
# Twilio credentials (only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Bird credentials (only when SMS_PROVIDER=bird)
BIRD_API_KEY=""
# Alphanumeric SMS sender name, max 11 characters
SMS_SENDER="ShaakirRS"
# Optional: Anthropic API key, only used to write short schedule summaries
ANTHROPIC_API_KEY=""
# Secret protecting /api/cron/run (reminders, overdue invoices, ledger check). Call it with: Authorization: Bearer <secret>. Use a long random value.
CRON_SECRET="change-me"
# Folder for generated files such as invoice PDFs (default: ./storage, git-ignored)
STORAGE_DIR="storage"
